# ============================================================
# DATABASE — Supabase Postgres
# Get both strings from: Supabase Dashboard -> Connect -> ORMs -> Prisma
#
# DATABASE_URL must be the POOLED string (port 6543) in production.
# DIRECT_URL must be the DIRECT string (port 5432) — used by the Prisma CLI
# for migrations. Running migrations through the pooler fails with
# 'prepared statement "s0" already exists'.
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Connection pool ceiling. Leave unset normally — the pg default applies.
# Set to 1 when running against `prisma dev`, whose PGLite engine is a wasm
# build that cannot serve concurrent connections. The e2e suite sets it itself.
# DATABASE_POOL_MAX=1

# ============================================================
# AUTH
# ============================================================
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_BOOTSTRAP_EMAIL=""         # promoted to ADMIN on first run; never self-service

# --- Google sign-in (optional) --------------------------------------------
# Both halves or neither: a client id with no secret configures a provider
# that fails at the redirect, so the button is hidden unless both are set.
#
#   1. https://console.cloud.google.com/ -> create or pick a project
#   2. APIs & Services -> OAuth consent screen -> External -> fill in the app
#      name and support email, and add your own address as a test user while
#      the screen is unpublished
#   3. APIs & Services -> Credentials -> Create credentials
#      -> OAuth client ID -> Web application
#   4. Authorised redirect URI, exactly:
#        http://localhost:3000/api/auth/callback/google
#      and, for the deployed site, the same path on its own origin.
#      BETTER_AUTH_URL must match that origin or Google rejects the callback.
#   5. Put the client ID and secret in .env.local — NOT here. This file is
#      committed, so a real value in it is a leaked credential; GitHub's push
#      protection has already caught that once.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments: Paystack (optional) ----------------------------------------
# The secret key both authenticates API calls and SIGNS WEBHOOKS, so it must
# never reach the browser. There is deliberately no NEXT_PUBLIC_ variable here.
#
# Without it, checkout is not offered and the webhook returns 503 rather than
# falling through to logic that grants passes.
#
#   1. https://dashboard.paystack.com/#/settings/developers
#   2. Copy the SECRET key. Use the test key (sk_test_...) until you are ready
#      to take real money; test and live keys sign with themselves, so a
#      mismatch shows up as every webhook failing its signature check.
#   3. On the same page, add a webhook URL:
#        https://<your-domain>/api/webhooks/paystack
#      Paystack cannot reach localhost. To test locally, tunnel it —
#      `npx untun@latest tunnel http://localhost:3000` or ngrok — and paste the
#      public URL. There is no "resend" button for a webhook Paystack could not
#      deliver, so a wrong URL is silent.
#   4. Confirm the price in src/config/plans.ts (PASS_PRICE_KOBO) matches what
#      you intend to charge. It is in KOBO: 2500000 is ₦25,000.
PAYSTACK_SECRET_KEY=""


# ============================================================
# AI — the app runs fully without these.
# With AI_PROVIDER=mock, generation uses a deterministic mock and the UI
# shows an explicit "AI not configured" state. Nothing is faked as real.
# ============================================================
AI_PROVIDER="mock"               # mock | anthropic
ANTHROPIC_API_KEY=""
AI_MODEL_GENERATION="claude-opus-5"
AI_MODEL_EDITING="claude-sonnet-5"

# ============================================================
# STORAGE
# ============================================================

# --- Supabase Storage (required only when STORAGE_DRIVER=supabase) ---------
# Uploads and exports are written to disk by the "local" driver, which is fine
# for development and useless on any host with an ephemeral filesystem — the
# files vanish on the next deploy.
#
#   1. Create a bucket. Storage -> New bucket, named "project-files",
#      and leave it PRIVATE. Buckets are private by default; a public one
#      would serve every student's project to anyone holding the URL.
#   2. Project Settings -> API. Copy the Project URL, and the
#      **service_role** key — not anon, not publishable.
#   3. Set the three values below and STORAGE_DRIVER="supabase".
#
# The service_role key bypasses row-level security. It is server-only: there
# is deliberately no NEXT_PUBLIC_ twin, because in Next.js that prefix is the
# difference between a secret and a published one. No storage policies are
# needed, since nothing reaches the driver that the app has not already
# authorised against the project's owner.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="project-files"

STORAGE_DRIVER="local"           # local | supabase | s3

# Set to "true" ONLY if STORAGE_LOCAL_DIR is on a disk that survives a restart
# — a VPS, not a serverless or container host. In production the app refuses to
# start on STORAGE_DRIVER="local" without it, because writing an export to a
# temporary directory succeeds and then loses the file with nothing reported.
STORAGE_LOCAL_PERSISTENT="false"
STORAGE_LOCAL_DIR="./.storage"
MAX_UPLOAD_MB="25"

# ============================================================
# EMAIL — console driver prints password-reset links to the server log
# ============================================================
# --- Email: Resend (required only when EMAIL_DRIVER=resend) ---------------
# Everything this app sends is consequential: a password reset, the address
# confirmation that unlocks Google sign-in, a receipt for a pass. The console
# driver prints them to the server log, which is genuine and works locally and
# reaches nobody in production.
#
#   1. https://resend.com -> API Keys -> create one (re_...).
#   2. Domains -> add and VERIFY a domain. Resend will not send from an
#      unverified one, so this is a hard prerequisite, not a nicety. It means
#      you need a domain before email works anywhere but the console.
#   3. Set EMAIL_FROM to an address at that domain. The friendly form works:
#      EMAIL_FROM="My Project Builder <hello@yourdomain.com>"
#   4. Set EMAIL_DRIVER="resend".
RESEND_API_KEY=""
EMAIL_FROM=""

EMAIL_DRIVER="console"           # console | resend | smtp
#
# Test it for real once configured — email is the one path nobody exercises by
# using the product, because every screen says "check your inbox" whether or not
# anything was sent, and the console driver reports success either way:
#
#   npm run email:test -- you@example.com
